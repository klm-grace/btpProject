meta {
  name: CORS allowed
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/health
  body: none
  auth: none
}

headers {
  Accept: application/json
  Origin: http://localhost:3000
}

assert {
  res.status: eq 200
  res.headers['access-control-allow-origin']: eq http://localhost:3000
  res.headers['access-control-allow-credentials']: eq 'true'
  res.headers['access-control-allow-methods']: isDefined
}
