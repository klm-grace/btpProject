meta {
  name: Preflight allowed
  type: http
  seq: 4
}

options {
  url: {{base_url}}/api/health
  body: none
  auth: none
}

headers {
  Origin: http://localhost:3000
  Access-Control-Request-Method: GET
}

assert {
  res.status: eq 204
  res.headers['access-control-allow-origin']: eq http://localhost:3000
  res.headers['access-control-allow-methods']: isDefined
  res.headers['access-control-max-age']: eq '86400'
}
