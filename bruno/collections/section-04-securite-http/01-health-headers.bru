meta {
  name: Health headers
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.success: eq true
  res.headers['strict-transport-security']: isDefined
  res.headers['x-frame-options']: eq DENY
  res.headers['x-content-type-options']: eq nosniff
  res.headers['content-security-policy']: eq default-src 'none'
  res.headers['referrer-policy']: eq strict-origin-when-cross-origin
}
