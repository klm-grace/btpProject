meta {
  name: Login échoué - email inexistant (pas d'énumération)
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "ghost_new_test@example.com",
    "password": "whatever"
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
}
