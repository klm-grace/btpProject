meta {
  name: Login réussi → cookie sid
  type: http
  seq: 5
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@btp-dev.local",
    "password": "admin1234"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.email: eq admin@btp-dev.local
  res.body.data.roles: isDefined
  res.headers['set-cookie']: isDefined
}
