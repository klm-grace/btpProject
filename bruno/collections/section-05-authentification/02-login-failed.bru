meta {
  name: Login échoué - mauvais mot de passe
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@btp-dev.local",
    "password": "WRONG_PASSWORD"
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
  res.body.error.code: eq invalid_credentials
}
