meta {
  name: Section 01 — Initialisation
  type: http
  seq: 1
}

get {
  url: {{base_url}}/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.status: eq ok
}

docs {
  Healthcheck : PostgreSQL et Redis doivent répondre ok.
  Statut attendu : 200 avec dependencies[postgresql]=ok et dependencies[redis]=ok.
}
