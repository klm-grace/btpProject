meta {
  name: Méthode non autorisée → 404 JSON
  type: http
  seq: 3
}

post {
  url: {{base_url}}/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 404
  res.body.error.code: eq not_found
}

docs {
  Les méthodes non supportées ne sont pas acceptées ; réponse JSON propre.
}
