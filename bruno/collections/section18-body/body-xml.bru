Content-Type: application/xml

<root><name>Jean</name><age>30</age></root>

---
name: XML DOCTYPE rejeté
description: Retourne 400 XML_DOCTYPE_NOT_ALLOWED
---

POST http://localhost:3000/api/test/body
Content-Type: application/xml

<!DOCTYPE foo [<!ENTITY xxe SYSTEM "file:///etc/passwd">]><root>&xxe;</root>

---
name: XML instruction processing rejetée
description: Retourne 400 XML_PROCESSING_INSTRUCTION_NOT_ALLOWED
---

POST http://localhost:3000/api/test/body
Content-Type: application/xml

<?xml version="1.0"?><root></root>

---
name: XML profond rejeté
description: Retourne 400 XML_MAX_DEPTH
---

POST http://localhost:3000/api/test/body
Content-Type: application/xml
X-Test-Xml-Depth: 3

<a><b><c><d><e>text</e></d></c></b></a>
