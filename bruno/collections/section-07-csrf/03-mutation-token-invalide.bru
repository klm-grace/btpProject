meta {
  name: Mutation admin avec token CSRF invalide → 403
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/auth/mfa/setup
  body: none
  auth: none
}

headers {
  X-CSRF-Token: aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
}

assert {
  res.status: eq 403
  res.body.success: eq false
  res.body.error.code: eq csrf_invalid
}
