meta {
  name: Login admin → cookie sid + csrf_token
  type: http
  seq: 1
}

post {
  url: {{base_url}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "admin@btp-dev.local",
    "password": "admin1234"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.headers['x-csrf-token']: isDefined
  res.headers['set-cookie']: isDefined
}

script:post-response {
  // Capture le token CSRF renvoyé au login pour les mutations suivantes
  const csrfToken = res.headers['X-CSRF-Token'] || res.headers['x-csrf-token'];
  if (csrfToken) {
    bru.setEnvVar('csrf_token', csrfToken);
  }
}
