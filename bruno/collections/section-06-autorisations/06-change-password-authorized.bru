meta {
  name: POST /api/auth/change-password - accès autorisé (requireAuth)
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "admin1234",
    "newPassword": "admin1234"
  }
}

assert {
  res.status: eq 200
  res.body.success: eq true
}
