meta {
  name: POST /api/auth/change-password - refusé (sans session)
  type: http
  seq: 2
}

post {
  url: {{base_url}}/api/auth/change-password
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "currentPassword": "admin1234",
    "newPassword": "admin1234"
  }
}

assert {
  res.status: eq 401
  res.body.success: eq false
  res.body.error.code: eq unauthorized
}
