meta {
  name: 405 — Méthode non autorisée
  type: http
  seq: 4
}

post {
  url: {{base_url}}/api/health
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 405
  res.body.success: eq false
  res.body.error.code: eq method_not_allowed
  res.headers['allow']: eq GET
}

docs {
  Vérifie qu'une méthode non supportée sur une route existante renvoie un 405.
  Le header Allow doit contenir les méthodes autorisées (GET).
}
