meta {
  name: Ready check
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/ready
  body: none
  auth: none
}

headers {
  Accept: application/json
}

assert {
  res.status: eq 200
  res.body.success: eq true
  res.body.data.ready: eq true
  res.body.requestId: isDefined
}

docs {
  Vérifie que l'application est prête (toutes les dépendances sont UP).
  Statut 200 si prêt, 503 si down.
}
