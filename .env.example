# ============================================================================
# BTP Project — Variables d'environnement
#
# Mêmes noms de variables en DEV et en PROD : seules les VALEURS changent.
# Copier ce fichier vers `.env` et remplacer les valeurs par les vôtres.
# `.env` est ignoré par Git (voir .gitignore) — ne jamais committer de secret.
# ============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
# Port HTTP de l'API (seul process qui écoute un port)
PORT=4000
HOST=127.0.0.1

# --- PostgreSQL (Bun.sql) ---------------------------------------------------
# DB exposée UNIQUEMENT en localhost (voir docker-compose.yml)
DATABASE_URL=postgres://btp_dev:btp_dev_password@127.0.0.1:5432/btp_dev

# --- Redis (Bun.redis) ------------------------------------------------------
# Redis exposé UNIQUEMENT en localhost (voir docker-compose.yml)
REDIS_URL=redis://:btp_dev_redis_password@127.0.0.1:6379
# Mot de passe Redis local (utilisé par docker-compose + REDIS_URL)
REDIS_PASSWORD=btp_dev_redis_password

# --- Niveau de log ----------------------------------------------------------
# Valeurs : trace | debug | info | warn | error
LOG_LEVEL=info

# --- Seed admin (optionnel en dev, obligatoire en production) ---------------
# SEED_ADMIN_PASSWORD=votre_mot_de_passe_admin

# --- Réservés aux sections suivantes (ne pas décommenter ici) ---------------
# S3_COMPAT_ENDPOINT=
# S3_COMPAT_REGION=
# S3_COMPAT_BUCKET=
# S3_COMPAT_ACCESS_KEY_ID=
# S3_COMPAT_SECRET_ACCESS_KEY=
# JWT_SECRET=
# SESSION_SECRET=
