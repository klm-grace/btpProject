# ============================================================================
# BTP Project — Variables d'environnement
#
# Mêmes noms de variables en DEV et en PROD : seules les VALEURS changent.
# Copier ce fichier vers `.env` et remplacer les valeurs par les vôtres.
# `.env` est ignoré par Git (voir .gitignore) — ne jamais committer de secret.
# ============================================================================

# --- Application ------------------------------------------------------------
NODE_ENV=development
# Port HTTP de l'API (seul process qui écoute un port)
PORT=4000
HOST=127.0.0.1

# --- PostgreSQL (Bun.sql) ---------------------------------------------------
# DB exposée UNIQUEMENT en localhost (voir docker-compose.yml)
DATABASE_URL=postgres://btp_dev:btp_dev_password@127.0.0.1:5432/btp_dev

# --- Redis (Bun.redis) ------------------------------------------------------
# Redis exposé UNIQUEMENT en localhost (voir docker-compose.yml)
REDIS_URL=redis://:btp_dev_redis_password@127.0.0.1:6379
# Mot de passe Redis local (utilisé par docker-compose + REDIS_URL)
REDIS_PASSWORD=btp_dev_redis_password

# --- Niveau de log ----------------------------------------------------------
# Valeurs : trace | debug | info | warn | error
LOG_LEVEL=info

# --- Sécurité HTTP ---------------------------------------------------------
# Liste blanche d'origines CORS (séparées par virgules)
CORS_ORIGINS=http://localhost:3000
# true si derrière un reverse proxy (nginx, Caddy, Cloudflare) en production
TRUST_PROXY=false
# Token secret pour accéder au health détaillé (vide = accès bloqué)
MONITORING_TOKEN=

# --- Logger ----------------------------------------------------------------
# true = formatage couleur en dev (terminal), false = JSON brut (production)
LOG_FORMATTED=true

# --- VictoriaLogs (logs centralisés) ---------------------------------------
# URL d'ingestion (protocole Loki). Vide = transport désactivé (fallback disque)
# LOG_LOKI_URL=http://victorialogs:9428/insert/loki/api/v1/push
# Labels attribués aux flux de logs
# LOG_LOKI_APP=btp-api
# LOG_LOKI_SERVICE=api
# Taille de batch + fréquence de flush (logs → VictoriaLogs)
# LOG_LOKI_BATCH_SIZE=50
# LOG_LOKI_FLUSH_INTERVAL_MS=500
# Timeout et tentatives en cas d'échec d'envoi
# LOG_LOKI_TIMEOUT_MS=5000
# LOG_LOKI_MAX_RETRIES=3

# --- Authentification / Sessions -------------------------------------------
# Secret pour hasher les tokens de session (requis en prod, générer avec: openssl rand -hex 32)
SESSION_SECRET=
# Durée de vie de la session en heures
SESSION_EXPIRY_HOURS=24
# Nom de l'issuer dans les QR codes TOTP
MFA_ISSUER=BTP Project
# Brute-force protection
BRUTE_FORCE_MAX_ATTEMPTS=5
BRUTE_FORCE_LOCKOUT_HOURS=1

# --- RBAC (permissions) ------------------------------------------------------
# TTL du cache des permissions par utilisateur (en minutes)
RBAC_CACHE_TTL_MINUTES=5

# --- Seed admin (optionnel en dev, obligatoire en production) ---------------
# SEED_ADMIN_PASSWORD=votre_mot_de_passe_admin

# --- Storage / Upload (section 09) ----------------------------------------
# Backend : "disk" (local) ou "r2" (Cloudflare R2)
# En dev/test : garder "disk"
STORAGE_BACKEND=disk

# Chemin local du stockage (persistant, pas dans /tmp)
STORAGE_DISK_PATH=./data/uploads

# Seuil de migration disque → R2 en bytes (20 Go par défaut)
STORAGE_DISK_MAX_BYTES=21474836480

# Max taille d'un fichier upload (10 Mo)
MAX_FILE_SIZE_BYTES=10485760

# MIME types autorisés (séparés par des virgules)
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# Dimensions max des images avant redimensionnement
IMAGE_MAX_WIDTH=1920
IMAGE_MAX_HEIGHT=1080

# Tailles des variantes (largeur en pixels)
VARIANT_SIZES=150,600

# --- Cloudflare R2 (décommenter pour activer) -----------------------------
# STORAGE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# STORAGE_R2_BUCKET=btp-media
# STORAGE_R2_ACCESS_KEY_ID=
# STORAGE_R2_SECRET_ACCESS_KEY=

# --- Réservés aux sections suivantes (ne pas décommenter ici) ---------------
# S3_COMPAT_ENDPOINT=
# S3_COMPAT_REGION=
# S3_COMPAT_BUCKET=
# S3_COMPAT_ACCESS_KEY_ID=
# S3_COMPAT_SECRET_ACCESS_KEY=
# JWT_SECRET=
# SESSION_SECRET=
