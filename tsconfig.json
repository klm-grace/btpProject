{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext"],
    "types": ["bun-types"],
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "paths": {
      "@libs/*": ["./src/libs/*"],
      "@app/*": ["./apps/*"],
      "@test/*": ["./test/*"]
    }
  },
  "include": ["apps/**/*.ts", "src/libs/**/*.ts", "src/types/**/*.d.ts", "test/**/*.ts"]
}