# ═══════════════════════════════════════════════════════════════
# Nginx — Reverse proxy sécurisé vers l'API Bun (btp-api:4000)
# ═══════════════════════════════════════════════════════════════

# ── HTTP : redirection vers HTTPS ───────────────────────────────
server {
    listen 80;
    listen [::]:80;
    server_name _;

    # Rate-limit de base sur la redirection
    limit_req zone=api_general burst=20 nodelay;
    limit_conn perip 20;

    # Redirect permanent vers HTTPS
    return 301 https://$host$request_uri;
}

# ── HTTPS : reverse proxy ───────────────────────────────────────
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name _;

    # ── TLS ─────────────────────────────────────────────────────
    ssl_certificate     /etc/nginx/certs/server.crt;
    ssl_certificate_key /etc/nginx/certs/server.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;
    ssl_session_tickets off;
    # Stapling désactivé pour les certs auto-signés (pas d'issuer accessible).
    # Activez-le en production avec de vrais certificats.
    ssl_stapling off;
    ssl_stapling_verify off;

    # ── Headers de sécurité (défense en profondeur) ─────────────
    # L'API applique déjà ces headers ; on les ré-applique côté proxy
    # pour couvrir aussi les réponses générées par nginx (502, etc.).
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()" always;

    # ── Rate limits ─────────────────────────────────────────────
    limit_conn perip 20;

    # ── Anti-scanners : répertoires sensibles bloqués ───────────
    location ~ /\. {
        deny all;
        return 404;
    }

    # ── Anti-path-traversal ─────────────────────────────────────
    location ~ (\.\.|%2e%2e) {
        return 400;
    }

    # ── Healthcheck sans bruit de log ───────────────────────────
    location = /nginx-health {
        access_log off;
        return 200 "nginx ok\n";
    }

    # ── Routes auth (bruteforce) — rate-limit strict ────────────
    location ~ ^/api/auth/(login|verify|mfa) {
        limit_req zone=api_auth burst=10 nodelay;
        proxy_pass http://api:4000;
        include /etc/nginx/proxy_params.conf;
    }

    # ── Formulaires publics — rate-limit renforcé ───────────────
    location ~ ^/api/public/ {
        limit_req zone=api_public burst=20 nodelay;
        proxy_pass http://api:4000;
        include /etc/nginx/proxy_params.conf;
    }

    # ── Tout le reste ───────────────────────────────────────────
    location / {
        limit_req zone=api_general burst=30 nodelay;
        proxy_pass http://api:4000;
        include /etc/nginx/proxy_params.conf;
    }
}